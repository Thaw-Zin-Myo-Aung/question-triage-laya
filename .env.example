# Which decision model to use: laya (free, runs on your PC) or jev (TypeSafe, paid)
DECISION_PROVIDER=laya
# Where laya-serve is listening
LAYA_URL=http://localhost:8000/v1/systemone
# Only needed when DECISION_PROVIDER=jev. Never commit the real .env file.
TYPESAFE_API_KEY=
# Answers below this probability go to the fallback
CONFIDENCE_THRESHOLD=0.6
# Optional: error | invalid | lowconf  (forces the fallback path for demos)
SIMULATE_FAILURE=
PORT=3000
